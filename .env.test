# Loaded by `npm test` via node --env-file. Placeholders only — the unit tests
# cover pure logic and never open a socket to any of these.
NODE_ENV=test
DATABASE_URL=postgres://postgres:postgres@localhost:5432/loinance_test
DATABASE_SSL=disable
JWT_SECRET=test-secret-that-is-at-least-32-characters-long
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=0
LOG_LEVEL=silent
