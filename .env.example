# Copy to .env and fill in. Never commit the filled copy.

NODE_ENV=development
PORT=8080

# Postgres 16+. Keep the instance in an Indian region (§2, data residency).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/loinance
# require | no-verify | disable. Forced on in production unless set to disable.
DATABASE_SSL=disable

# 32+ bytes. Rotating this invalidates every session.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-at-least-32-random-bytes-000000

# Leave empty in development so the cookie is host-only on localhost.
COOKIE_DOMAIN=

# Comma-separated. No wildcard — wildcards cannot carry cookies anyway.
CORS_ORIGIN=http://localhost:5173

# EXACT number of proxy hops in front of this process. Never "true":
# that lets a caller forge X-Forwarded-For and defeat every IP rule (§5.1).
#   0 = process is directly exposed
#   1 = one nginx / one load balancer
TRUST_PROXY=0
# Set to true ONLY when every request reaches this process through Cloudflare,
# otherwise CF-Connecting-IP is attacker-controlled.
TRUST_CLOUDFLARE=false

# Cloudflare Turnstile server key. Required when NODE_ENV=production.
# Left empty in development, the captcha check is skipped with a warning.
TURNSTILE_SECRET=

LEAD_DEDUPE_WINDOW_HOURS=24

# Anti-bot: minimum seconds between form render and submit (§5.2).
BOT_MIN_FORM_SECONDS=3

# Auth (§6)
SESSION_HOURS=8

# Export (§9)
EXPORT_MAX_ROWS=10000

# Retention (§11.7). Nightly jobs run in-process when enabled — turn this on
# for exactly one instance, or run `npm run job:nightly` from cron instead.
RUN_NIGHTLY_JOBS=false
NIGHTLY_JOB_HOUR_IST=2
LEAD_RETENTION_MONTHS=24

LOG_LEVEL=info
