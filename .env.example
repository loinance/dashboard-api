# Copy to .env and fill in. Never commit the filled copy.

NODE_ENV=development
# The platform injects PORT. Do not set it yourself on a managed host.
PORT=8080
# `::` also accepts IPv4 on a dual-stack host, and is required for Railway's
# IPv6-only private network. Override only to bind a specific interface.
HOST=::

# Postgres 16+. Keep the instance in an Indian region (§2, data residency).
# On Railway, reference the database service instead of pasting a literal:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/loinance

# require | no-verify | disable. Leave unset and the right value is inferred
# from the host: `disable` for localhost and *.railway.internal (which does not
# speak TLS at all), `no-verify` for Railway's public proxy (self-signed cert),
# `require` for anything else in production.
DATABASE_SSL=disable

# Apply pending migrations at boot. A managed host has no release phase, so
# this is the only hook that runs before the first request of a new deploy.
# Turn it on for a single-replica service; otherwise run the migration as a
# pre-deploy command (`npm run db:migrate:prod`) and leave this false.
RUN_MIGRATIONS_ON_BOOT=false

# 32+ bytes. Rotating this invalidates every session.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-at-least-32-random-bytes-000000

# Leave empty in development so the cookie is host-only on localhost.
COOKIE_DOMAIN=

# lax | strict | none. Unset means `lax` in development and `none` in
# production, because a deployed API and dashboard sit on different registrable
# domains and `lax` would drop the session cookie from every admin XHR.
# `none` requires the Secure flag, which is only set when NODE_ENV=production.
COOKIE_SAMESITE=

# Comma-separated. No wildcard — wildcards cannot carry cookies anyway.
CORS_ORIGIN=http://localhost:5173

# EXACT number of proxy hops in front of this process. Never "true":
# that lets a caller forge X-Forwarded-For and defeat every IP rule (§5.1).
#   0 = process is directly exposed
#   1 = one nginx / one load balancer / Railway's edge proxy
TRUST_PROXY=0
# Set to true ONLY when every request reaches this process through Cloudflare,
# otherwise CF-Connecting-IP is attacker-controlled.
TRUST_CLOUDFLARE=false

# Cloudflare Turnstile server key. Required when NODE_ENV=production.
# Left empty in development, the captcha check is skipped with a warning.
TURNSTILE_SECRET=

LEAD_DEDUPE_WINDOW_HOURS=24

# Anti-bot: minimum seconds between form render and submit (§5.2).
BOT_MIN_FORM_SECONDS=3

# Auth (§6)
SESSION_HOURS=8

# Export (§9)
EXPORT_MAX_ROWS=10000

# Retention (§11.7). Nightly jobs run in-process when enabled — turn this on
# for exactly one instance, or run `npm run job:nightly` from cron instead.
RUN_NIGHTLY_JOBS=false
NIGHTLY_JOB_HOUR_IST=2
LEAD_RETENTION_MONTHS=24

LOG_LEVEL=info
